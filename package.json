{
  "name": "cricket-scoreboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx shared/engine.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:scorers": "tsx scripts/e2e-scorers.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "mongoose": "8.24.3",
    "nanoid": "5.1.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
