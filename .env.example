# Copy to .env for local development. Never commit the real .env.
#
# MongoDB Atlas M0 (free forever). Two things that bite people:
#   1. Put the database name in the path, BEFORE the "?" — omit it and Mongo
#      silently writes to a database called "test".
#   2. Use an alphanumeric-only password. Any of @ : / ? # [ ] % must be
#      percent-encoded in the URI, which is a miserable thing to debug.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cricket?retryWrites=true&w=majority

# Optional — defaults to 3000 locally. Render injects its own PORT.
PORT=3000
